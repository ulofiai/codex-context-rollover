{
  "description": "Record each Codex compaction and recommend a fresh task after repeated compaction.",
  "hooks": {
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/post-compact.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording context checkpoint"
          }
        ]
      }
    ]
  }
}
