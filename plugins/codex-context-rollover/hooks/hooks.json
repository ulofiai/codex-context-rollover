{
  "description": "Save a lossless snapshot after repeated compaction and load it once on explicit /clear.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/context-rollover.mjs\"",
            "timeout": 30,
            "statusMessage": "Loading one-time rollover handoff",
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/context-rollover.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording context checkpoint"
          }
        ]
      }
    ]
  }
}
